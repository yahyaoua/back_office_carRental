<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Car Rental Client</title>

    @* ADDED: Bootstrap CSS for styling *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @*  Optional: Font Awesome for icons like the checkmark on the confirmation page *@
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
</head>
<body>
    <header>
        <nav class="custom-navbar">
            <div class="nav-container">

                <!-- Logo / Brand -->
                <a class="brand" asp-controller="Home" asp-action="Index">
                    CarRental
                </a>

                <!-- Menu -->
                <ul class="nav-links">
                    <li>
                        <a asp-controller="Home" asp-action="Index">Accueil</a>
                    </li>
                    <li>
                        <a asp-controller="Account" asp-action="Login">Connexion</a>
                    </li>
                    <li>
                        <a asp-controller="Home" asp-action="About">À propos</a>
                    </li>
                    <li>
                        <a asp-controller="Home" asp-action="Contact">Contact</a>
                    </li>
                    @if (User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="ReservationPage"
                               asp-action="MyReservations">
                                Mes réservations
                            </a>
                        </li>
                    }

                </ul>
            </div>
        </nav>

    </header>

    <div class="container">
        @* NOUVEAU: Display Success/Error Messages (TempData) *@
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - CarRental Client
        </div>
    </footer>

    @* REQUIRED: jQuery and Bootstrap JS for forms, alerts, and dynamic content *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/reservation.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>