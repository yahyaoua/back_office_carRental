@model CarRental.Api.ViewModels.RegisterClientViewModel
@{
    ViewData["Title"] = "Create Account";
}

<div class="auth-page">
    <div class="login-wrapper">
        <div class="login-card large">
            <h2>Create Account</h2>

            <form asp-action="Register" method="post">

                <input type="hidden" name="vehicleId" value="@ViewData["VehicleId"]" />

                <div class="form-group">
                    <label>First Name</label>
                    <input asp-for="FirstName" class="form-control" />
                </div>

                <div class="form-group">
                    <label>Last Name</label>
                    <input asp-for="LastName" class="form-control" />
                </div>

                <div class="form-group">
                    <label>Email</label>
                    <input asp-for="Email" class="form-control" />
                </div>

                <div class="form-group">
                    <label>Phone</label>
                    <input asp-for="Phone" class="form-control" />
                </div>

                <div class="form-group">
                    <label>Address</label>
                    <input asp-for="Address" class="form-control" />
                </div>

                <div class="form-group">
                    <label>Driver License Number</label>
                    <input asp-for="DriverLicenseNumber" class="form-control" />
                </div>

                <div class="form-group">
                    <label>Birth Date</label>
                    <input asp-for="BirthDate" type="date" class="form-control" />
                </div>

                <div class="form-group">
                    <label>Password</label>
                    <input asp-for="Password" type="password" class="form-control" />
                </div>

                <button type="submit" class="btn btn-primary w-100">
                    Create Account
                </button>

                <div class="text-center mt-3">
                    <a asp-action="Login">Already have an account? Login</a>
                </div>
            </form>
        </div>
    </div>
</div>
